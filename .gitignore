# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# netlify — scratch dir the Netlify CLI writes when it bundles the functions
# in netlify/functions/ (`netlify dev`, `netlify functions:serve`). Generated
# output plus the site link, never source.
/.netlify/

# typescript
*.tsbuildinfo
next-env.d.ts
